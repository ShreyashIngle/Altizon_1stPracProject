<div x-data="{ notifications: [] }" 
     x-init="
        window.addEventListener('notification', event => {
          notifications.push(event.detail)
          // Optional: auto remove after 5s
          setTimeout(() => notifications.shift(), 5000)
        })
     "
     class="fixed top-4 right-4 space-y-2 z-50">

  <template x-for="notif in notifications" :key="notif.id">
    <div class="bg-blue-500 text-white p-3 rounded shadow">
      <strong x-text="notif.model"></strong>: <span x-text="notif.message"></span>
      <small class="block text-xs" x-text="notif.at"></small>
    </div>
  </template>
</div>
